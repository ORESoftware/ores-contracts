{
  "name": "@oresoftware/ores-contracts",
  "version": "0.1.1",
  "description": "Independent TypeSpec and JSON Schema authorities → parity-checked SQL, SeaORM (code-first), Diesel (db-first), Rust, TypeScript and Dart artifacts for *-interfaces, *-orm-core, *-clients and servers.",
  "type": "module",
  "license": "MIT",
  "bin": { "ores-contracts": "bin/ores-contracts.mjs" },
  "exports": {
    ".": "./src/cli.mjs",
    "./ir": "./src/ir.mjs",
    "./emit": "./src/emit/index.mjs",
    "./tjsv-admission": "./src/tjsv-admission.mjs"
  },
  "scripts": { "test": "node --test test/*.test.mjs", "check": "node src/cli.mjs check --config test/fixtures/contracts.config.json" },
  "peerDependencies": {
    "@typespec/compiler": ">=0.60",
    "@oresoftware/typespec-json-schema-validator": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@typespec/compiler": { "optional": true },
    "@oresoftware/typespec-json-schema-validator": { "optional": true }
  }
}
