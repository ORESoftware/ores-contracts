{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://oresoftware.dev/schemas/provider-benchmark-target-receipt-v1.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema","targetId","provider","region","releaseId","requestCorpusSha256","artifactReceipts","resourceProfile","samples","billing"],
  "properties":{
    "schema":{"const":"ores.provider-benchmark.target-receipt/v1"},
    "targetId":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,62}$"},
    "provider":{"type":"string","minLength":1},
    "region":{"type":"string","minLength":1},
    "releaseId":{"type":"string","minLength":1},
    "requestCorpusSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "artifactReceipts":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
    "resourceProfile":{
      "type":"object","additionalProperties":false,"required":["architecture"],
      "properties":{
        "architecture":{"type":"string","minLength":1},
        "memoryMb":{"type":"integer","minimum":1},
        "cpuMillis":{"type":"integer","minimum":1},
        "concurrency":{"type":"integer","minimum":1},
        "mode":{"type":"string","minLength":1}
      }
    },
    "samples":{
      "type":"object","additionalProperties":false,
      "required":["requestCount","errorCount","throttledCount","coldCount","warmCount","durationMs","throughputRps","latency"],
      "properties":{
        "requestCount":{"type":"integer","minimum":1},
        "errorCount":{"type":"integer","minimum":0},
        "throttledCount":{"type":"integer","minimum":0},
        "coldCount":{"type":"integer","minimum":0},
        "warmCount":{"type":"integer","minimum":0},
        "durationMs":{"type":"integer","minimum":1},
        "throughputRps":{"type":"number","minimum":0},
        "latency":{
          "type":"object","additionalProperties":false,"required":["p50Ms","p95Ms","p99Ms"],
          "properties":{
            "p50Ms":{"type":"number","minimum":0},
            "p95Ms":{"type":"number","minimum":0},
            "p99Ms":{"type":"number","minimum":0}
          }
        }
      }
    },
    "billing":{
      "type":"object","additionalProperties":false,
      "required":["basis","amount","currency","pricingSnapshotAsOf"],
      "properties":{
        "basis":{"enum":["measured","estimated"]},
        "amount":{"type":"number","minimum":0},
        "currency":{"type":"string","pattern":"^[A-Z]{3}$"},
        "pricingSnapshotAsOf":{"type":"string","minLength":1},
        "billableDurationMs":{"type":"integer","minimum":0},
        "billableInstanceMs":{"type":"integer","minimum":0}
      }
    }
  }
}
