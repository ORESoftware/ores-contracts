{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/contracts/implementation-deviation-review.v1.schema.json",
  "$ref": "#/$defs/DeviationReview",
  "$defs": {
    "DeviationReview": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "schema",
        "decision",
        "scope",
        "observable_conformance",
        "security_policy_conformance",
        "annotation",
        "id",
        "repository",
        "source_revision",
        "source_path",
        "operation_id",
        "language",
        "runtime",
        "reason",
        "tracking_issue",
        "expires_on",
        "positive_case_ids",
        "negative_case_ids",
        "contract_ir_digest"
      ],
      "properties": {
        "schema": {
          "const": "ores.conformance.deviation-review/v1"
        },
        "decision": {
          "const": "review_requested"
        },
        "scope": {
          "const": "implementation_representation_only"
        },
        "observable_conformance": {
          "const": "mandatory"
        },
        "security_policy_conformance": {
          "const": "mandatory"
        },
        "annotation": {
          "const": "@ores-conformance-deviation"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,127}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 32
        },
        "tracking_issue": {
          "type": "string",
          "pattern": "^https://github[.]com/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/issues/[1-9][0-9]*$"
        },
        "expires_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "positive_case_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "negative_case_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "contract_ir_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
